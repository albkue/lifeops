# =====================================================================
# LifeOps — environment configuration (copy to `.env` and edit)
# All credentials live here. NEVER commit the real `.env`.
# =====================================================================

# ----------------------------- PostgreSQL ----------------------------
POSTGRES_USER=lifeops
POSTGRES_PASSWORD=lifeops
POSTGRES_DB=lifeops
POSTGRES_PORT=5432
# Used by the Python services (inside docker network: host is `postgres`)
DATABASE_URL=postgresql+psycopg://lifeops:lifeops@postgres:5432/lifeops
# When running services on the host against compose Postgres, use:
# DATABASE_URL=postgresql+psycopg://lifeops:lifeops@localhost:5432/lifeops

# ------------------------------- MinIO -------------------------------
# Decision (2026-11-10): MinIO's official registry images are license-gated,
# so v1 runs SeaweedFS (Apache 2.0, S3-compatible) at the same hostname.
# To swap back to real MinIO one day:
#   MINIO_IMAGE=quay.io/minio/minio:latest   (requires docker login quay.io)
MINIO_IMAGE=chrislusf/seaweedfs:latest
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=lifeops
MINIO_SECRET_KEY=lifeops-secret
MINIO_BUCKET=lifeops
MINIO_SECURE=false
# Host-side endpoint (for scripts and local pytest):
MINIO_LOCAL_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001

# ------------------------- LifeOps general ---------------------------
# Day-boundary timezone for daily logs / reports / Life Balance Score.
# All timestamps are STORED in UTC; this drives "which day is today".
# UTC+7
LIFEOPS_TIMEZONE=Asia/Ho_Chi_Minh
LIFEOPS_ENV=local
LOG_LEVEL=INFO
# Optional stable UUID for the primary user row (defaults to first created user)
#LIFEOPS_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# --------------------- Ingestion service (FastAPI) -------------------
INGESTION_API_PORT=8000
INSIGHTS_API_PORT=8001

# --------------- External sources (all optional, later phases) --------
# GitHub PAT (Phase 6). Leave empty to skip the source entirely.
GITHUB_TOKEN=
# Google Calendar OAuth (Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/ingestion/calendar/oauth/callback
# Spotify OAuth (Phase 11)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Open-Meteo needs no key (Phase 11). Location= UTC+7 city.
WEATHER_LATITUDE=10.8231
WEATHER_LONGITUDE=106.6297
WEATHER_LOCATION_NAME=Ho Chi Minh City
